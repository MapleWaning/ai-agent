# 复制为 .env 或 app/.env.local 后填写真实值（勿提交密钥）

# 阿里 DashScope（对齐 Java application.yml spring.ai.dashscope）
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_MODEL=qwen-plus

# DashScope OpenAI 兼容模式（可选，供 langchain-openai 使用）
# DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 联网搜索（对齐 Java search-api.api-key）
SEARCH_API_KEY=your-search-api-key

# 服务端口（默认与 uvicorn 一致）
# HOST=0.0.0.0
# PORT=8000

# Java 侧向量检索（PgVector 留 Java 时使用，后续 P1 对接）
# JAVA_BASE_URL=http://localhost:8123/api
